{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Jānu Setu backup",
  "type": "object",
  "required": ["app", "version", "exportedAt", "settings", "days"],
  "properties": {
    "app": { "enum": ["janu-setu", "jaanu-setu"], "description": "jaanu-setu is the legacy value from before the rename" },
    "version": { "type": "integer", "minimum": 1 },
    "exportedAt": { "type": "string", "format": "date-time" },
    "settings": { "type": "object" },
    "weeks": { "type": "object", "propertyNames": { "pattern": "^\\d{4}-\\d{2}-\\d{2}$" } },
    "days": {
      "type": "object",
      "propertyNames": { "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
      "additionalProperties": { "type": "object", "required": ["date", "ticked", "counters", "log"] }
    }
  }
}
